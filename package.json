{
  "name": "dsh-collab-workbench",
  "version": "0.1.0",
  "description": "DeepSeek Harness 多 Agent 协作工作台：自定义角色、项目群聊、任务自动调度、群内权限审批与执行恢复", 
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "workbench",
    "collaboration"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wind7rui/dsh-collab-workbench.git"
  },
  "homepage": "https://github.com/wind7rui/dsh-collab-workbench#readme",
  "bugs": {
    "url": "https://github.com/wind7rui/dsh-collab-workbench/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/client/approval-ui.js",
    "src/client/update-ui.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "scripts/*.mjs"
  ],
  "scripts": {
    "build": "node scripts/build-approvals.mjs && node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --import ./test/register.mjs --test \"test/*.test.js\"",
    "test:native": "python3 test/native-e2e.py"
  },
  "peerDependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-workspace": "*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-approval", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-workspace"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}